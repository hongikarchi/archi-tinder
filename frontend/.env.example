VITE_API_BASE_URL=http://localhost:8001/api/v1

# Social login client IDs (public — safe to expose in frontend).
# Only VITE_GOOGLE_CLIENT_ID is wired today (LoginPage.jsx Google button).
# Kakao + Naver are future placeholders — backend KakaoLoginView / NaverLoginView
# exist (apps/accounts/views.py) but the LoginPage buttons are pending the
# FRONT-AUTH-1 task in Task.md `## Next ### LOW`.
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_JS_KEY=                # (future, FRONT-AUTH-1 — not yet wired)
VITE_NAVER_CLIENT_ID=             # (future, FRONT-AUTH-1 — not yet wired)
VITE_NAVER_CALLBACK_URL=          # (future, FRONT-AUTH-1 — not yet wired)

# Gemini API key — reserved for future direct-frontend Gemini call paths.
# Currently unused: all Gemini access is backend-only (backend/apps/recommendation/services/parse_query.py + reports.py).
VITE_GEMINI_API_KEY=               # (future, no current frontend call site)

# Dev-only: bypass OAuth in local development (must match backend DEV_LOGIN_SECRET)
# Leave empty in production. The Dev Login button only renders when import.meta.env.DEV is true.
VITE_DEV_LOGIN_SECRET=
