# macOS
.DS_Store

# Claude Code -- whitelist shared config under .claude/; ignore everything else
#   (forward-safe against new subpaths like .claude/memory/, .claude/sessions/, etc.)
.claude/*
!.claude/agents/
!.claude/codex/
!.claude/commands/
!.claude/plans/
!.claude/postmortems/
!.claude/reviews/
!.claude/validations/
!.claude/handoffs-archive/
!.claude/codex-tasks/
!.claude/codex-tasks-archive/
!.claude/plans-archive/
!.claude/Goal.md
!.claude/Report.md
!.claude/Task.md
!.claude/WORKFLOW.md
!.claude/SESSION_PROTOCOL.md
!.claude/resolved-archive.md

# Python / Django (backend — future)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.sqlite3
.env
.env.*
!.env.example
.pytest_cache/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Web-tester / Playwright artifacts
.playwright-mcp/
test_*.png
ss*.png
test_*.mjs

# Web-testing E2E runner output
web-testing/reports/
web-testing/dashboard/data/

# /review Part B browser-verification artifacts (per-SHA snapshot + traces)
test-artifacts/

# Python coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Frontend build output (Vite)
frontend/dist/
frontend/build/

# Process / lock / runtime artefacts
*.pid
*.swp
*.swo

# Certificates / private keys (defense-in-depth — no .key / .pem
# files should ever be committed; .gitignore is a backstop, not the
# primary control)
*.pem
*.crt
*.cer
*.key
*.p12
*.pfx
secrets/
credentials/

# Windows (협업자 OS 다양화 대비)
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor temp / backup
*~
*.bak
*.orig
.#*
\#*\#
