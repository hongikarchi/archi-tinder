  "special_findings": {
    "divisare_format_lock": "Divisare images.divisare.com serves JPEG regardless of Accept: image/webp or Accept: image/avif header, even with Chrome User-Agent. f_auto Cloudinary param is NOT honoring browser format negotiation. Reason unknown (likely Divisare CDN config).",
    "architizer_imgix_format_negotiation": "architizer-prod.imgix.net with ?auto=format DOES serve AVIF when Accept: image/avif is sent. Measured: 380KB JPEG → 115KB AVIF (70% reduction). Browser currently receives JPEG because <img> does not send a custom Accept header. A proxy with Vary:Accept or a server-side URL rewrite could unlock this.",
    "divisare_w_auto": "Divisare primary URLs use w_auto (no width constraint) → serves original full-res width, up to 8256px. Gallery fallback URLs (/image/upload/c_fit,f_jpg,q_80,w_1200/) ARE width-capped at 1200px and would be preferable for swipe-card use.",
    "browser_cors_opaque": "transferSize=0 for Divisare/Archello in browser ResourceTiming = these CDNs do not set Timing-Allow-Origin. Duration is real (observed 1.28–2.26 s in-browser). Byte count not obtainable from browser.",
