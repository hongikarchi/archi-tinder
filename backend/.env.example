# --- Database: Make Web app data (Neon PostgreSQL) ---
# Make Web's own tables (accounts / profiles / recommendation / social).
# `migrate` runs against this DB only.
#
# DEV-vs-PROD endpoint discipline (INFRA-ENV-1, 2026-05-25):
#   LOCAL  → point at a Neon CHILD branch off production (currently
#            `local-dev-2`, endpoint `ep-holy-band-a1w0u5am`). Never point local
#            at the production endpoint — local swipe/save would write straight
#            into real prod rows.
#   RAILWAY/PROD → production branch endpoint (currently `ep-broad-hat-a1jaomn7`).
#                  Env vars live on Railway, never in this file.
# Re-provision the child branch via:
#   `neonctl branches create --name local-dev-N --parent production \
#       --project-id holy-pond-45504245`
#
# Role separation (INFRA-DB-1, 2026-05-25):
#   Django runtime → `make_web_app` (LOGIN + SELECT/INSERT/UPDATE/DELETE on
#                    public.* + USAGE/SELECT on sequences; NO DDL, NO role mgmt,
#                    NO extension privileges). This is what Railway prod + local
#                    `.env` SHOULD use.
#   Migrations     → `neondb_owner` (full DDL). Run `manage.py migrate` from
#                    the operator's machine with a TEMPORARY DB_USER swap to
#                    `neondb_owner`; never leave neondb_owner in a long-running
#                    runtime env.
# `make_web_app` does NOT inherit `neon_superuser` (Neon CLI grants it by
# default — create the role via psql with explicit `NOSUPERUSER NOCREATEDB
# NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS` instead of `neonctl roles
# create`). GRANT block + ALTER DEFAULT PRIVILEGES kept idempotent; future
# migration tables auto-grant.
DB_HOST=your-neon-dev-branch.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_USER=make_web_app
DB_PASSWORD=your_make_web_app_password
DB_NAME=user_data
DB_SSLMODE=require

# --- Database: building reference data (Neon PostgreSQL) ---
# Make-DB-owned `canonical_v2_buildings` + `canonical_v2_architects`, read-only.
# Make Web NEVER migrates this DB. Required — a missing BUILDINGS_DB_* var fails
# loud at startup. Make Web uses a dedicated SELECT-only role `make_web` distinct
# from the `neondb_owner` writer role Make DB uses. Same host as DB_* (one Neon
# branch, two databases: `user_data` + `archi_data`). The Neon CoW branch carries
# both DBs so the dev-branch endpoint serves both `archi_data` (read-only) and
# `user_data` (read+write) from a single hostname.
BUILDINGS_DB_HOST=your-neon-dev-branch.ap-southeast-1.aws.neon.tech
BUILDINGS_DB_PORT=5432
BUILDINGS_DB_USER=make_web
BUILDINGS_DB_PASSWORD=your_buildings_ro_password
BUILDINGS_DB_NAME=archi_data
BUILDINGS_DB_SSLMODE=require

# --- Django ---
DJANGO_SECRET_KEY=generate_with_get_random_secret_key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Images (Cloudflare R2) ---
IMAGE_BASE_URL=https://pub-5d2133d166fc4b65ad05295df352519f.r2.dev

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key

# --- HuggingFace (Stage 2 embedding API per IMP-6) ---
HF_TOKEN=your_huggingface_api_token

# --- Feature flags ---
# IMP-6: parse_query 2-stage decouple. Set 'true' to enable async stage 2 path.
STAGE_DECOUPLE_ENABLED=false

# --- Cache backend (INFRA-REDIS-1) ---
# Set on Railway prod to a Redis service URL (e.g. ${{Redis.REDIS_URL}}) so multi-worker
# Gunicorn shares cache (PR 3 JTI cache, PR 4 async prefetch consume).
# Leave blank for local dev to fall back to LocMemCache (no Redis daemon needed).
REDIS_URL=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kakao OAuth ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Naver OAuth ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Dev Login (automated testing only — set a long random string) ---
DEV_LOGIN_SECRET=
